{
  "name": "pi-ollama-cloud-provider",
  "version": "0.5.0",
  "type": "module",
  "description": "Ollama Cloud provider extension for pi coding agent with dynamic model discovery",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "ollama-cloud"
  ],
  "license": "MIT",
  "files": [
    "extensions/",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mario-gc/pi-ollama-cloud-provider"
  },
  "bugs": {
    "url": "https://github.com/mario-gc/pi-ollama-cloud-provider/issues"
  },
  "homepage": "https://github.com/mario-gc/pi-ollama-cloud-provider#readme",
  "pi": {
    "extensions": [
      "./extensions/ollama-cloud/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@tsconfig/node24": "^24.0.0",
    "@tsconfig/node-ts": "^23.6.0",
    "@types/node": "^24.0.0"
  }
}
